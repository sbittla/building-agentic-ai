# Copy this file to .env and fill in your keys. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: choose a different model (see platform.claude.com/docs/en/models/overview)
# MODEL=claude-sonnet-5

# ---- Free local model instead of Claude (Appendix H of the book) ----
# 1. ./course.sh local up        (starts Ollama and downloads qwen3.5:9b, about 6.6 GB, once)
# 2. Uncomment the next line. No API key needed. Set it back to claude (or delete it) to
#    use Claude again; exercises marked "Claude only" need that.
# PROVIDER=local
# The model the book is written for:
# LOCAL_MODEL=qwen3.5:9b
# Context window in tokens (more needs more memory):
# LOCAL_CONTEXT=32768
# off = skip the model's reasoning step: faster on a CPU, a little less accurate:
# LOCAL_THINKING=auto
# Seconds to wait for one reply from the local model (a CPU needs minutes on long runs):
# MODEL_TIMEOUT=600
# Only if Ollama runs as a normal app on your computer (Mac), not in Docker:
# OLLAMA_URL=http://host.docker.internal:11434

# Optional (chapter 14 and capstone 5): a GitHub personal access token.
# Use a fine-grained token with READ-ONLY permissions.
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...

# Optional: if your network blocks ghcr.io, build the image without GitHub's server.
# GITHUB_MCP_IMAGE=nogithub

# ---- Part 6 (chapters 17-19), all optional ----
# Chapter 17 embeddings: auto (default: Voyage if a key is set, else the local model),
# local, voyage or hashing.
# EMBEDDER=auto
# VOYAGE_API_KEY=pa-...

# Chapter 19 agent API: comma-separated keys callers must send (long and random:
# ./course.sh setup creates one for you). The API refuses to start without them.
# AGENT_API_KEYS=
# AGENT_RATE_PER_MINUTE=10
# AGENT_MAX_STEPS=8
# AGENT_MAX_TOKENS=40000

# Chapter 19 remote MCP server: a read+write token, and optionally a read-only one.
# MCP_TOKEN=
# MCP_READONLY_TOKEN=
