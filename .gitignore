# Your own work and secrets never go into the repository.
.env
workspace/
*.log
# ...except the exercise outputs written by run-chapter (solutions/outputs)
!solutions/outputs/**/*.log

# Python and tools
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Exercise and Code Index (generated locally with symlinks)
solutions/exercises/_index/
course/code/_index/

# Old tooling and notes kept locally, not part of the course
_archive/
