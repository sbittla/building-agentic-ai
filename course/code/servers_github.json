{
  "servers": {
    "git":    {"command": "mcp-server-git", "args": ["--repository", "."],
               "log": "mcp_servers.log"},
    "time":   {"command": "mcp-server-time", "log": "mcp_servers.log"},
    "github": {"command": "github-mcp-server",
               "args": ["stdio", "--read-only", "--toolsets", "repos,issues"],
               "pass_env": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
               "log": "mcp_servers.log"}
  }
}
